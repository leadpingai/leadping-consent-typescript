{
  "name": "@leadping/consent",
  "version": "1.0.2",
  "description": "Leadping consent capture SDK for browser forms.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leadpingai/leadping-consent-typescript.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/leadping-consent.js",
  "jsdelivr": "./dist/leadping-consent.min.js",
  "unpkg": "./dist/leadping-consent.min.js",
  "sideEffects": ["./dist/leadping-consent.js", "./dist/leadping-consent.min.js"],
  "files": [
    "dist/leadping-consent*.js*",
    "dist/esm",
    "dist/browser"
  ],
  "exports": {
    ".": "./dist/leadping-consent.js",
    "./esm": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node build.mjs",
    "test": "node --test test/*.test.mjs",
    "benchmark": "node test/benchmark.mjs"
  },
  "dependencies": {
    "rrweb": "2.1.7",
    "@rrweb/types": "2.1.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
